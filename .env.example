# Required for production canonical URLs, sitemap and robots output.
VITE_SITE_URL=https://www.example.com

# Required to accept assessment requests. Must accept POST application/json.
# Leave blank until the secure CRM/form endpoint and its CORS policy are approved.
VITE_ASSESSMENT_ENDPOINT=

# Optional post-submit scheduling handoff. Omit to hide the calendar action.
VITE_CALENDAR_URL=

# Optional approved ranges only. JSON array or | / ; delimited text are supported.
# Leave blank to render no investment field; never publish unapproved ranges.
VITE_BUDGET_RANGES=
