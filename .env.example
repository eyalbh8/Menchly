# Required for production canonical URLs, sitemap and robots output.
VITE_SITE_URL=https://www.example.com

# Same-origin enquiry API. Vite serves this in `npm run dev`.
VITE_ASSESSMENT_ENDPOINT=/api/enquiry

# Telegram bot that posts contact and assessment submissions.
# For a group: add the bot, send a message in the group, then run: npm run telegram-chat-id
# Use the group/supergroup ID (it is a negative number).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cal.com booking page. A cal.com URL (or username/event slug) opens the in-page scheduler.
VITE_CALENDAR_URL=

# Optional approved ranges only. JSON array or | / ; delimited text are supported.
# Leave blank to render no investment field; never publish unapproved ranges.
VITE_BUDGET_RANGES=
